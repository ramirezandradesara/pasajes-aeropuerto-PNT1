@{
    ViewData["Title"] = "Inicio";
    ViewData["FullWidth"] = true;
}

<header class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="row">
            <div class="col-lg-8">
                <h1 class="hero-title">Tu viaje comienza con nosotros.</h1>
                <p class="lead fs-4">Emití tu pasaje, elegí destino y vuelo en un solo paso.</p>
            </div>
        </div>
    </div>
</header>

<section class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="search-widget">
                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="alert alert-success mb-4" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@mensaje
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger mb-4" role="alert">@error</div>
                }

                <div class="form-container">
                    <h2>Emitir pasaje</h2>
                    <form asp-action="AgregarPasaje" method="post">
                        <div class="form-group">
                            <label for="DestinoId">Destino:</label>
                            <select id="DestinoId" name="DestinoId" asp-items="ViewBag.Destinos" class="form-control form-control-custom">
                                <option value="">Seleccionar destino...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="VueloId">Vuelo:</label>
                            <select id="VueloId" name="VueloId" asp-items="ViewBag.Vuelos" class="form-control form-control-custom">
                                <option value="">Seleccionar vuelo...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="AvionId">Avión:</label>
                            <select id="AvionId" name="AvionId" asp-items="ViewBag.Aviones" class="form-control form-control-custom">
                                <option value="">Seleccionar avión...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="CantPersonas">Cantidad de personas:</label>
                            <input type="number" id="CantPersonas" name="CantPersonas" value="1" min="1" max="10" class="form-control form-control-custom" />
                        </div>
                        <div class="form-group">
                            <label for="Nombre">Nombre:</label>
                            <input type="text" id="Nombre" name="Nombre" class="form-control form-control-custom" />
                        </div>
                        <div class="form-group">
                            <label for="Apellido">Apellido:</label>
                            <input type="text" id="Apellido" name="Apellido" class="form-control form-control-custom" />
                        </div>
                        <div class="form-group">
                            <label for="Dni">DNI:</label>
                            <input type="text" id="Dni" name="Dni" class="form-control form-control-custom" />
                        </div>
                        <div class="form-group">
                            <label for="Email">Email:</label>
                            <input type="text" id="Email" name="Email" class="form-control form-control-custom" />
                        </div>
                        <div>
                            <button type="submit" class="btn-submit">Agregar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var navbar = document.querySelector('.navbar');
            if (!navbar) return;
            window.addEventListener('scroll', function () {
                navbar.style.boxShadow = window.scrollY > 50
                    ? '0 4px 20px rgba(0,0,0,0.1)'
                    : '0 2px 15px rgba(0,0,0,0.05)';
            });
        });
    </script>
}
