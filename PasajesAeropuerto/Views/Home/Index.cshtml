@using PasajesAeropuerto.Entities
@using PasajesAeropuerto.Models
@using PasajesAeropuerto.Services
@{
    ViewData["Title"] = "Inicio";
    ViewData["FullWidth"] = true;
    var simulacion = ViewBag.Simulacion as SimulacionPrecioResultado;
    var claseSel = ViewBag.Clase as string ?? "Economica";
    var cantPersonas = (int)(ViewBag.CantPersonas ?? 1);
    var pasajeros = ViewBag.Pasajeros as List<PasajeroFormModel> ?? new List<PasajeroFormModel>();
    var tiposEquipaje = ViewBag.TiposEquipaje as List<TipoEquipaje> ?? new List<TipoEquipaje>();
    var origenesLista = ViewBag.OrigenesLista as List<Origen> ?? new List<Origen>();
    var destinosLista = ViewBag.DestinosLista as List<Destino> ?? new List<Destino>();
    var origenSeleccionado = ViewBag.OrigenIdSeleccionado as int?;
    var destinoSeleccionado = ViewBag.DestinoIdSeleccionado as int?;
}

<header class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="row">
            <div class="col-lg-8">
                <h1 class="hero-title">Tu viaje comienza con nosotros.</h1>
                <p class="lead fs-4">Completá los datos, consultá el precio y emití tu pasaje.</p>
            </div>
        </div>
    </div>
</header>

<section class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="search-widget">
                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="alert alert-success mb-4" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@mensaje
                    </div>
                }
                @if (ViewBag.Error is string error)
                {
                    <div class="alert alert-danger mb-4" role="alert">@error</div>
                }

                <form id="formPasaje" method="post">
                    <div class="form-container">
                        <h2><span class="paso-numero">1</span> Datos del viaje</h2>
                        <div class="form-group">
                            <label for="OrigenId">Origen:</label>
                            <select id="OrigenId" name="OrigenId" class="form-control form-control-custom">
                                <option value="">Seleccionar origen...</option>
                                @foreach (var origen in origenesLista)
                                {
                                    if (origenSeleccionado == origen.Id)
                                    {
                                        <option value="@origen.Id" data-ciudad="@origen.Nombre" selected>@origen.Nombre</option>
                                    }
                                    else
                                    {
                                        <option value="@origen.Id" data-ciudad="@origen.Nombre">@origen.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="DestinoId">Destino:</label>
                            <select id="DestinoId" name="DestinoId" class="form-control form-control-custom">
                                <option value="">Seleccionar destino...</option>
                                @foreach (var destino in destinosLista)
                                {
                                    if (destinoSeleccionado == destino.Id)
                                    {
                                        <option value="@destino.Id" data-ciudad="@destino.Nombre" selected>@destino.Nombre</option>
                                    }
                                    else
                                    {
                                        <option value="@destino.Id" data-ciudad="@destino.Nombre">@destino.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="VueloId">Vuelo:</label>
                            <select id="VueloId" name="VueloId" asp-items="ViewBag.Vuelos" class="form-control form-control-custom">
                                <option value="">Seleccionar vuelo...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="Clase">Clase de asiento:</label>
                            <select id="Clase" name="Clase" class="form-control form-control-custom">
                                @if (claseSel == "Economica")
                                {
                                    <option value="Economica" selected>Económica (x1.0 — 23 kg)</option>
                                }
                                else
                                {
                                    <option value="Economica">Económica (x1.0 — 23 kg)</option>
                                }
                                @if (claseSel == "Business")
                                {
                                    <option value="Business" selected>Business (x2.0 — 30 kg)</option>
                                }
                                else
                                {
                                    <option value="Business">Business (x2.0 — 30 kg)</option>
                                }
                                @if (claseSel == "Primera")
                                {
                                    <option value="Primera" selected>Primera Clase (x3.5 — 40 kg)</option>
                                }
                                else
                                {
                                    <option value="Primera">Primera Clase (x3.5 — 40 kg)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="CantPersonas">Cantidad de personas:</label>
                            <input type="number" id="CantPersonas" name="CantPersonas"
                                   value="@(ViewBag.CantPersonas ?? 1)" min="1" max="10"
                                   class="form-control form-control-custom" />
                        </div>
                        <div class="mb-4">
                            <button type="submit" formaction="@Url.Action("VerPrecios")" class="btn btn-accent">
                                <i class="fa-solid fa-calculator me-2"></i>Ver precios
                            </button>
                        </div>
                    </div>

                    @if (simulacion is not null)
                    {
                        <partial name="_DesglosePrecio" model="simulacion" />

                        <div class="form-container paso-pasajero mt-2">
                            <h2><span class="paso-numero">2</span> Datos de los pasajeros</h2>
                            <p class="text-muted mb-4">Completá los datos de cada una de las @cantPersonas persona(s) del viaje.</p>
                            <input type="hidden" name="PreciosVistos" value="true" />
                            @for (var i = 0; i < cantPersonas; i++)
                            {
                                var pasajero = i < pasajeros.Count ? pasajeros[i] : new PasajeroFormModel();
                                <partial name="_PasajeroForm" model="(pasajero, i, tiposEquipaje)" />
                            }
                            <div>
                                <button type="submit" formaction="@Url.Action("AgregarPasaje")" class="btn-submit">
                                    <i class="fa-solid fa-ticket me-2"></i>Emitir pasaje
                                </button>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var navbar = document.querySelector('.navbar');
            if (navbar) {
                window.addEventListener('scroll', function () {
                    navbar.style.boxShadow = window.scrollY > 50
                        ? '0 4px 20px rgba(0,0,0,0.1)'
                        : '0 2px 15px rgba(0,0,0,0.05)';
                });
            }

            var origenSelect = document.getElementById('OrigenId');
            var destinoSelect = document.getElementById('DestinoId');
            if (!origenSelect || !destinoSelect) return;

            function normalizarCiudad(texto) {
                return (texto || '').trim().toLocaleLowerCase();
            }

            function ciudadSeleccionada(select) {
                var option = select.options[select.selectedIndex];
                if (!option || !option.value) return '';
                return normalizarCiudad(option.dataset.ciudad || option.textContent);
            }

            function actualizarFiltroOrigenDestino(origenCambio) {
                var ciudadOrigen = ciudadSeleccionada(origenSelect);
                var ciudadDestino = ciudadSeleccionada(destinoSelect);

                Array.from(destinoSelect.options).forEach(function (option) {
                    if (!option.value) return;
                    var ocultar = ciudadOrigen && normalizarCiudad(option.dataset.ciudad) === ciudadOrigen;
                    option.hidden = ocultar;
                    option.disabled = ocultar;
                });

                Array.from(origenSelect.options).forEach(function (option) {
                    if (!option.value) return;
                    var ocultar = ciudadDestino && normalizarCiudad(option.dataset.ciudad) === ciudadDestino;
                    option.hidden = ocultar;
                    option.disabled = ocultar;
                });

                if (origenCambio && ciudadOrigen && ciudadOrigen === ciudadDestino) {
                    destinoSelect.value = '';
                } else if (!origenCambio && ciudadDestino && ciudadOrigen === ciudadDestino) {
                    origenSelect.value = '';
                }

                var destinoOption = destinoSelect.options[destinoSelect.selectedIndex];
                if (destinoOption && destinoOption.disabled) {
                    destinoSelect.value = '';
                }

                var origenOption = origenSelect.options[origenSelect.selectedIndex];
                if (origenOption && origenOption.disabled) {
                    origenSelect.value = '';
                }
            }

            origenSelect.addEventListener('change', function () {
                actualizarFiltroOrigenDestino(true);
            });
            destinoSelect.addEventListener('change', function () {
                actualizarFiltroOrigenDestino(false);
            });
            actualizarFiltroOrigenDestino(true);
        });
    </script>
}
