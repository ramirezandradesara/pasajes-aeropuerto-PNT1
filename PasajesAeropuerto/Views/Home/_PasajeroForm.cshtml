@using PasajesAeropuerto.Entities
@using PasajesAeropuerto.Models
@model (PasajeroFormModel Pasajero, int Indice, List<TipoEquipaje> TiposEquipaje)

@{
    var i = Model.Indice;
    var p = Model.Pasajero;
    var tipoMano = Model.TiposEquipaje.FirstOrDefault(t => t.Id == TipoEquipaje.IdMano);
    var tipoValija = Model.TiposEquipaje.FirstOrDefault(t => t.Id == TipoEquipaje.IdValija);
    var tipoAdicional = Model.TiposEquipaje.FirstOrDefault(t => t.Id == TipoEquipaje.IdAdicional);
}

<div class="pasajero-block border rounded p-3 mb-4">
    <h3 class="h5 mb-3">Pasajero @(i + 1)</h3>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="form-group mb-md-0">
                <label for="Pasajeros_@(i)__Nombre">Nombre:</label>
                <input type="text" id="Pasajeros_@(i)__Nombre" name="Pasajeros[@i].Nombre"
                       value="@p.Nombre" class="form-control form-control-custom" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-md-0">
                <label for="Pasajeros_@(i)__Apellido">Apellido:</label>
                <input type="text" id="Pasajeros_@(i)__Apellido" name="Pasajeros[@i].Apellido"
                       value="@p.Apellido" class="form-control form-control-custom" />
            </div>
        </div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <div class="form-group mb-md-0">
                <label for="Pasajeros_@(i)__Dni">DNI:</label>
                <input type="text" id="Pasajeros_@(i)__Dni" name="Pasajeros[@i].Dni"
                       value="@p.Dni" class="form-control form-control-custom" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-md-0">
                <label for="Pasajeros_@(i)__Email">Email:</label>
                <input type="text" id="Pasajeros_@(i)__Email" name="Pasajeros[@i].Email"
                       value="@p.Email" class="form-control form-control-custom" />
            </div>
        </div>
    </div>
    <div class="form-group mb-0 mt-3">
        <label>Equipaje:</label>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="EquipajeMano_@i" checked disabled />
            <label class="form-check-label" for="EquipajeMano_@i">@(tipoMano?.Nombre ?? "Equipaje de mano") (incluido)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="Pasajeros_@(i)__EquipajeValija"
                   name="Pasajeros[@i].EquipajeValija" value="true"
                   @(p.EquipajeValija ? "checked" : "") />
            <label class="form-check-label" for="Pasajeros_@(i)__EquipajeValija">
                @(tipoValija?.Nombre ?? "Valija") (+ @(tipoValija?.Recargo.ToString("C0") ?? "$0"))
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="Pasajeros_@(i)__EquipajeAdicional"
                   name="Pasajeros[@i].EquipajeAdicional" value="true"
                   @(p.EquipajeAdicional ? "checked" : "") />
            <label class="form-check-label" for="Pasajeros_@(i)__EquipajeAdicional">
                @(tipoAdicional?.Nombre ?? "Equipaje adicional") (+ @(tipoAdicional?.Recargo.ToString("C0") ?? "$0"))
            </label>
        </div>
    </div>
</div>
